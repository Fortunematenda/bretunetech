# Copy to /var/www/bretunetech-staging/backend/.env — never commit real secrets.
# NEVER point DATABASE_URL at the production database.

NODE_ENV=production
PORT=4005

DATABASE_URL=postgresql://bretune_staging:CHANGE_ME_DB_PASSWORD@127.0.0.1:5432/bretunetech_staging?schema=public

# Separate JWT / token secrets from production
JWT_SECRET=CHANGE_ME_STAGING_JWT_LONG_RANDOM
NEWSLETTER_TOKEN_SECRET=CHANGE_ME_STAGING_NEWSLETTER_TOKEN

SITE_URL=https://staging.bretunetech.com
API_PUBLIC_URL=https://staging-api.bretunetech.com/api
NEWSLETTER_SITE_URL=https://staging.bretunetech.com
NEWSLETTER_API_PUBLIC_URL=https://staging-api.bretunetech.com/api

FRONTEND_URL=https://staging.bretunetech.com
CORS_ORIGIN=https://staging.bretunetech.com

# Keep bulk send off for initial staging; mock provider blocks all external mail.
NEWSLETTER_SENDING_ENABLED=false
NEWSLETTER_WORKER_ENABLED=false
NEWSLETTER_DOUBLE_OPT_IN=true
NEWSLETTER_PROVIDER=mock
MAIL_MOCK=1

NEWSLETTER_FROM_NAME=BretuneTech Staging
NEWSLETTER_FROM_EMAIL=newsletter-staging@bretunetech.com

# Do not set RESEND_API_KEY / NEWSLETTER_SMTP_* on staging.
