# Public API on VPS (161.97.120.107) — include /api
NEXT_PUBLIC_API_URL=https://api.bretunetech.com/api

# Optional Google Maps (address autocomplete)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Optional Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Optional Search Console / Bing verification
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# Optional Microsoft Clarity project id (heatmaps)
NEXT_PUBLIC_CLARITY_PROJECT_ID=
